---
import Portal from '../../layouts/Portal.astro';
import Icono from '../../components/Icono';
import { SECCIONES, porGrupos } from '../../lib/navegacion';
const proxmox = SECCIONES.find((s) => s.id === 'proxmox')!;
---
<Portal titulo="Proxmox">
  <header class="cabecera-app">
    <div>
      <h1>¿Qué quieres hacer?</h1>
      <p>Cada utilidad te prepara un bloque para pegar en la terminal del servidor.</p>
    </div>
    <nav class="acciones-app" aria-label="Configuración">
      <a class="btn btn-pequeno" href="/proxmox/guia/"><Icono nombre="info" tam={16} />Primeros pasos</a>
      <a class="btn btn-pequeno" href="/proxmox/ajustes/"><Icono nombre="ajustes" tam={16} />Ajustes</a>
    </nav>
  </header>

  <div class="aviso-guia" id="aviso-guia" hidden>
    <Icono nombre="info" />
    <span>¿Es la primera vez? Antes de crear la primera clase hay que preparar Proxmox una vez.</span>
    <a class="btn btn-pequeno btn-primario" href="/proxmox/guia/">Ver primeros pasos</a>
    <button type="button" class="icono-boton" id="cerrar-guia" aria-label="No volver a mostrar">✕</button>
  </div>

  <div class="grupos-herramientas">
    {porGrupos(proxmox.enlaces).map(([grupo, enlaces]) => (
      <section class="grupo-herramientas" aria-labelledby={`g-${grupo}`}>
        <h2 id={`g-${grupo}`}>{grupo}</h2>
        <div class="herramientas">
          {enlaces.map((e) => (
            <a class="herramienta" href={e.href}>
              <span class="herramienta-icono"><Icono nombre={e.icono} tam={22} /></span>
              <span class="herramienta-texto"><strong>{e.nombre}</strong><small>{e.descripcion}</small></span>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</Portal>

<script>
  const CLAVE = 'utilidades-prieto:guia-cerrada';
  const aviso = document.getElementById('aviso-guia')!;
  try {
    if (!localStorage.getItem(CLAVE)) aviso.hidden = false;
  } catch {
    aviso.hidden = false;
  }
  document.getElementById('cerrar-guia')!.addEventListener('click', () => {
    aviso.hidden = true;
    try { localStorage.setItem(CLAVE, '1'); } catch {}
  });
</script>
