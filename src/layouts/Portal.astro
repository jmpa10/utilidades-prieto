---
import '../styles/global.css';
import Icono from '../components/Icono';
import { SECCIONES } from '../lib/navegacion';
import { CENTRO } from '../lib/centro';

interface Props {
  titulo: string;
  descripcion?: string;
}
const { titulo, descripcion = `Utilidades del ${CENTRO.departamento} del ${CENTRO.nombre} para el profesorado.` } = Astro.props;
const ruta = Astro.url.pathname.replace(/\/?$/, '/');
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={descripcion} />
    <meta name="robots" content="noindex" />
    <link rel="icon" href={CENTRO.logo} type="image/png" />
    <title>{titulo} | Utilidades Prieto</title>
    <script is:inline>
      try {
        const t = localStorage.getItem('utilidades-prieto:tema');
        if (t) document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <header class="cabecera">
      <div class="cabecera-interior">
        <a class="marca" href="/" aria-label="Utilidades Prieto, inicio">
          <img class="marca-logo" src={CENTRO.logo} alt="" width="40" height="41" />
          <span class="marca-texto"><strong>Utilidades Prieto</strong><span>{CENTRO.departamento}</span></span>
        </a>
        <nav class="apps" aria-label="Aplicaciones">
          {SECCIONES.map((s) => (
            <a class="app" href={`/${s.id}/`} aria-current={ruta.startsWith(`/${s.id}/`) ? 'page' : undefined}>
              <Icono nombre={s.icono} tam={18} />{s.nombre}{s.pronto && <span class="app-pronto">pronto</span>}
            </a>
          ))}
        </nav>
        <div class="cabecera-acciones">
          <a class="icono-boton" href={CENTRO.repositorio} target="_blank" rel="noopener" aria-label="Código en GitHub" title="Código en GitHub">
            <Icono nombre="github" tam={18} />
          </a>
          <button class="icono-boton" type="button" id="boton-tema" aria-label="Cambiar entre tema claro y oscuro" title="Tema claro u oscuro">
            <span data-icono="luna"><Icono nombre="luna" tam={18} /></span>
            <span data-icono="sol" hidden><Icono nombre="sol" tam={18} /></span>
          </button>
        </div>
      </div>
    </header>
    <main class="principal">
      <div class="contenido">
        <slot />
      </div>
    </main>
    <footer class="pie">
      <span>{CENTRO.departamento} · {CENTRO.nombre}. Todo se genera en tu navegador: no se envían ni se guardan datos.</span>
      <span>
        <a href={CENTRO.repositorio} target="_blank" rel="noopener">Código abierto</a> con licencia MIT, por{' '}
        <a href={CENTRO.autor.github} target="_blank" rel="noopener">{CENTRO.autor.nombre}</a>
      </span>
    </footer>
    <slot name="fuera" />
    <script>
      const raiz = document.documentElement;
      const boton = document.getElementById('boton-tema')!;
      const oscuro = () =>
        raiz.dataset.theme ? raiz.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      const pintar = () => {
        boton.querySelector<HTMLElement>('[data-icono="luna"]')!.hidden = oscuro();
        boton.querySelector<HTMLElement>('[data-icono="sol"]')!.hidden = !oscuro();
      };
      pintar();
      boton.addEventListener('click', () => {
        raiz.dataset.theme = oscuro() ? 'light' : 'dark';
        try { localStorage.setItem('utilidades-prieto:tema', raiz.dataset.theme); } catch {}
        pintar();
      });
    </script>
  </body>
</html>
